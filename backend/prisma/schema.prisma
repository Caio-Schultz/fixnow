generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================================================================
// ENUMS
// ==============================================================================

enum TipoUsuario {
  CLIENTE
  PROFISSIONAL
  AMBOS
  INATIVO

  @@map("tipo_usuario_enum")
}

enum TipoDocumento {
  CPF
  CNPJ

  @@map("tipo_documento_enum")
}

enum TipoSolicitacao {
  NORMAL
  URGENCIA

  @@map("tipo_solicitacao_enum")
}

enum PerfilEndereco {
  CLIENTE
  PROFISSIONAL

  @@map("perfil_endereco_enum")
}

enum StatusSolicitacao {
  PENDENTE
  ORCAMENTO  @map("ORÇAMENTO") // Prisma não aceita "Ç" no identificador; o valor no banco continua "ORÇAMENTO"
  CONFIRMADO
  RECUSADO
  CANCELADO
  CONCLUIDO

  @@map("status_solicitacao_enum")
}

enum StatusPagamento {
  PENDENTE
  CONFIRMADO

  @@map("status_pagamento_enum")
}

// ==============================================================================
// CADASTRO DE USUÁRIO
// ==============================================================================

model Usuario {
  idUsuario     Int           @id @default(autoincrement()) @map("id_usuario")
  tipoUsuario   TipoUsuario   @map("tipo_usuario")
  nome          String        @db.VarChar(100)
  tipoDocumento TipoDocumento @map("tipo_documento")
  documento     String        @unique @db.VarChar(14)
  dataNasc      DateTime      @map("data_nasc") @db.Date
  dataCriacao   DateTime      @default(now()) @map("data_criacao") @db.Timestamptz(6)

  profissional           Profissional?
  cliente                Cliente?
  otps                   OtpRecuperacaoSenha[]
  enderecos              Endereco[]
  solicitacoesCanceladas Solicitacao[]         @relation("SolicitacaoCanceladoPor")

  @@map("usuarios")
}

model Profissao {
  idProfissao   Int    @id @default(autoincrement()) @map("id_profissao")
  nomeProfissao String @unique @map("nome_profissao") @db.VarChar(50)

  profissionais Profissional[]

  @@map("profissoes")
}

// Tabela filha: profissionais (PK compartilhada com usuarios)
model Profissional {
  idProfissional     Int       @id @map("id_profissional")
  idProfissao        Int       @map("id_profissao")
  especialidades     String?   @db.VarChar(255)
  anosExperiencia    Int?      @map("anos_experiencia")
  valorHora          Decimal   @map("valor_hora") @db.Decimal(12, 2)
  areaAtendimento    Int       @map("area_atendimento")
  telefone           String    @db.VarChar(14)
  email              String    @unique @db.VarChar(255)
  senha              String    @db.VarChar(255)
  fotoPerfil         String?   @map("foto_perfil") @db.VarChar(255)
  perfilAtivo        Boolean   @default(true) @map("perfil_ativo")
  dataAtivacaoPerfil DateTime  @default(now()) @map("data_ativacao_perfil") @db.Timestamptz(6)
  dataDesativacao    DateTime? @map("data_desativacao") @db.Timestamptz(6)

  usuario      Usuario       @relation(fields: [idProfissional], references: [idUsuario], onDelete: Restrict, onUpdate: Cascade, map: "profissionais_id_profissional_fkey")
  profissao    Profissao     @relation(fields: [idProfissao], references: [idProfissao], onDelete: Restrict, onUpdate: Cascade, map: "profissionais_id_profissao_fkey")
  solicitacoes Solicitacao[]

  @@map("profissionais")
}

// Tabela filha: clientes (PK compartilhada com usuarios)
model Cliente {
  idCliente          Int       @id @map("id_cliente")
  telefone           String    @db.VarChar(14)
  email              String    @unique @db.VarChar(255)
  senha              String    @db.VarChar(255)
  fotoPerfil         String?   @map("foto_perfil") @db.VarChar(255)
  perfilAtivo        Boolean   @default(true) @map("perfil_ativo")
  dataAtivacaoPerfil DateTime  @default(now()) @map("data_ativacao_perfil") @db.Timestamptz(6)
  dataDesativacao    DateTime? @map("data_desativacao") @db.Timestamptz(6)

  usuario      Usuario       @relation(fields: [idCliente], references: [idUsuario], onDelete: Restrict, onUpdate: Cascade, map: "clientes_id_cliente_fkey")
  solicitacoes Solicitacao[]

  @@map("clientes")
}

// ==============================================================================
// RECUPERAÇÃO DE SENHA (OTP)
// ==============================================================================

model OtpRecuperacaoSenha {
  idOtp       Int      @id @default(autoincrement()) @map("id_otp")
  idUsuario   Int      @map("id_usuario")
  codigo      String   @db.VarChar(6)
  expiraEm    DateTime @map("expira_em") @db.Timestamptz(6)
  tentativas  Int      @default(0) @db.SmallInt
  usado       Boolean  @default(false)
  dataCriacao DateTime @default(now()) @map("data_criacao") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario], onDelete: Restrict, onUpdate: Cascade, map: "otp_recuperacao_senha_id_usuario_fkey")

  @@map("otp_recuperacao_senha")
}

// ==============================================================================
// ENDEREÇOS
// ==============================================================================

model Endereco {
  idEndereco     Int            @id @default(autoincrement()) @map("id_endereco")
  idUsuario      Int            @map("id_usuario")
  perfilEndereco PerfilEndereco @map("perfil_endereco")
  cep            String         @db.VarChar(9)
  estado         String         @db.VarChar(2)
  cidade         String         @db.VarChar(50)
  bairro         String         @db.VarChar(50)
  rua            String         @db.VarChar(100)
  numero         String         @db.VarChar(10)
  complemento    String?        @db.VarChar(50)
  latitude       Decimal        @db.Decimal(9, 6)
  longitude      Decimal        @db.Decimal(9, 6)
  enderecoPadrao Boolean        @default(false) @map("endereco_padrao")

  usuario      Usuario       @relation(fields: [idUsuario], references: [idUsuario], onDelete: Restrict, onUpdate: Cascade, map: "enderecos_id_usuario_fkey")
  solicitacoes Solicitacao[]

  @@map("enderecos")
}

// ==============================================================================
// OPERAÇÕES, AGENDA E HISTÓRICO
// ==============================================================================

model Servico {
  idServico Int      @id @default(autoincrement()) @map("id_servico")
  problema  String   @db.VarChar(50)
  descricao String   @db.VarChar(250)
  fotos     String[] @default([]) @db.VarChar(255)

  solicitacoes Solicitacao[]

  @@map("servicos")
}

model Solicitacao {
  idSolicitacao    Int               @id @default(autoincrement()) @map("id_solicitacao")
  idCliente        Int               @map("id_cliente")
  idProfissional   Int               @map("id_profissional")
  idServico        Int               @map("id_servico")
  idEndereco       Int?              @map("id_endereco")
  dataServico      DateTime          @map("data_servico") @db.Date
  horaServico      DateTime          @map("hora_servico") @db.Time(3)
  tipoSolicitacao  TipoSolicitacao   @default(NORMAL) @map("tipo_solicitacao")
  orcamento        Decimal?          @db.Decimal(12, 2)
  formaPagamento   String?           @map("forma_pagamento") @db.VarChar(20)
  status           StatusSolicitacao @default(PENDENTE)
  canceladoPor     Int?              @map("cancelado_por")
  dataCancelamento DateTime?         @map("data_cancelamento") @db.Timestamptz(6)
  dataCriacao      DateTime          @default(now()) @map("data_criacao") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  cliente      Cliente      @relation(fields: [idCliente], references: [idCliente], onDelete: Restrict, onUpdate: Cascade, map: "solicitacoes_id_cliente_fkey")
  profissional Profissional @relation(fields: [idProfissional], references: [idProfissional], onDelete: Restrict, onUpdate: Cascade, map: "solicitacoes_id_profissional_fkey")
  servico      Servico      @relation(fields: [idServico], references: [idServico], onDelete: Restrict, onUpdate: Cascade, map: "solicitacoes_id_servico_fkey")
  endereco     Endereco?    @relation(fields: [idEndereco], references: [idEndereco], onDelete: Restrict, onUpdate: Cascade, map: "solicitacoes_id_endereco_fkey")
  cancelador   Usuario?     @relation("SolicitacaoCanceladoPor", fields: [canceladoPor], references: [idUsuario], onDelete: Restrict, onUpdate: Cascade, map: "solicitacoes_cancelado_por_fkey")
  pagamento    Pagamento?

  @@index([idCliente, status], map: "solicitacoes_id_cliente_status_idx")
  @@index([idProfissional, status], map: "solicitacoes_id_profissional_status_idx")
  @@map("solicitacoes")
}

// ==============================================================================
// FINANCEIRO
// ==============================================================================

model Pagamento {
  idPagamento    Int             @id @default(autoincrement()) @map("id_pagamento")
  idSolicitacao  Int             @unique @map("id_solicitacao")
  valor          Decimal         @db.Decimal(12, 2)
  formaPagamento String          @map("forma_pagamento") @db.VarChar(20)
  status         StatusPagamento @default(PENDENTE)
  dataPagamento  DateTime        @default(now()) @map("data_pagamento") @db.Timestamptz(6)

  solicitacao Solicitacao @relation(fields: [idSolicitacao], references: [idSolicitacao], onDelete: Restrict, onUpdate: Cascade, map: "pagamentos_id_solicitacao_fkey")

  @@map("pagamentos")
}
